APP_NAME="HRX"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_DEMO=false
APP_TIMEZONE="Asia/Kolkata"
APP_URL=https://hrx.hitechgroup.in

DB_MYSQL_DUMP_PATH="C:/laragon/bin/mysql/mysql-8.4.3-winx64/bin"

TELESCOPE_ENABLED=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hrx_local
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp-mail.outlook.com
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="info@hitechgroup.in"
MAIL_FROM_NAME="${APP_NAME}"

# Browser push (standard W3C Web Push / VAPID -- not Firebase). Generate once:
#   php artisan tinker --execute="print_r((new \Minishlink\WebPush\VAPID())::createVapidKeys());"
# Never regenerate once real subscriptions exist -- it invalidates all of them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:ai@rustx.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

JWT_SECRET=

GOOGLE_MAPS_API_KEY=

REVERB_APP_ID=407132
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=hrx.hitechgroup.in
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Backup Security Key Check
BACKUP_LICENSE_KEY=ENTER_YOUR_ACTIVATION_KEY_HERE

# ── Telephony: CentroVision -> HRX webhook ingest ───────────────────────────
# Issued BY HRX TO the vendor. Generate with:
#   php -r 'echo bin2hex(random_bytes(24))."\n".bin2hex(random_bytes(32))."\n";'
TELEPHONY_INBOUND_API_KEY=
TELEPHONY_INBOUND_SECRETS=
# The CentroVision gateway's public address -- the same host HRX already calls
# for click-to-call (see access.click_to_call.endpoint). Comma-separated;
# CIDR accepted. LEAVING THIS EMPTY DISABLES THE CHECK, which is fine for local
# development and wrong for production.
TELEPHONY_ALLOWED_IPS=45.120.40.194
# Must never be empty: every telephony table has a unique index starting with
# tenant_id, and MySQL treats NULLs in a unique index as distinct.
TELEPHONY_DEFAULT_TENANT_ID=default

# Issued BY the vendor TO HRX. Blank until they build the JSON API.
TELEPHONY_VENDOR_BASE_URL=
TELEPHONY_VENDOR_API_KEY=
TELEPHONY_VENDOR_VERIFY_TLS=false

TELEPHONY_QUEUE=telephony

# While the feature is in testing, limit the telephony SCREENS to these
# people. Comma separated; empty means no restriction and the normal role
# rules apply. Does not affect the vendor ingest API.
TELEPHONY_RESTRICT_TO_EMAILS=
