# Copy to deployment/.env.deploy and fill in. That file is gitignored —
# never commit real credentials; git history keeps them forever.
# The real values are kept outside the repository (ask the server owner).
HRX_SSH_HOST=your.server.host
HRX_SSH_PORT=22
HRX_SSH_USER=your_ssh_user
HRX_SSH_PASSWORD=
HRX_APP_ROOT=/home/your_ssh_user/domains/your-domain/public_html/hrx
HRX_PHP=/opt/alt/php84/usr/bin/php

# Database (only needed for import/export helpers)
HRX_DB_NAME=your_db_name
HRX_DB_USER=your_db_user
HRX_DB_PASSWORD=
