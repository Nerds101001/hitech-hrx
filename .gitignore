/storage/app/*.xlsx
/storage/app/*.pdf
/kingo-bingo-targets-*.pdf

# Office lock files (created while an .xlsx is open, deleted on close).
~$*

# Generated reports and exports written into storage/app at runtime. Same
# reasoning as the block above - byproducts, not source.
/storage/app/*.xlsx
/storage/app/htmlpurifier/
/storage/app/cg-shortleave-backup-*.json

# Sample exports produced while testing the Kingo Bingo download buttons.
/kingo-bingo-targets-*.xlsx
/kingo-bingo-targets-*.pdf

# The CRM .NET solution is a SEPARATE application that was unzipped into this
# repo's root. It belongs in its own repository, and its appsettings.json
# files carry live connection strings and passwords - committing it here would
# publish those credentials to everyone with repo access.
/CRM.API/
/CRM.API.zip

# Generated KPI scorecards. Produced on demand by /kpi/my?pdf= and
# /performance/scorecards?pdf=, landing in the repo root when run from here -
# byproducts of a report run, not source, and they carry named employees'
# appraisal figures.
/KPI-Scorecard-*.pdf

# Work-order QC reports downloaded for reference while investigating.
/QC Report - *.pdf

# A 265 MB Google Drive installer that was downloaded into the repo root.
# Committing it would bloat every clone permanently and could only be undone
# by rewriting history.
/GoogleDriveSetup.exe
